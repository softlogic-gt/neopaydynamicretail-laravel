{
    "name": "softlogic-gt/neopay-dynamic-retail-laravel",
    "description": "NeoPay Dynamic Retail POS package for Laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Softlogic",
            "email": "software@softlogic.com.gt"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "SoftlogicGT\\NeoPayDynamicRetail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SoftlogicGT\\NeoPayDynamicRetail\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SoftlogicGT\\NeoPayDynamicRetail\\NeoPayDynamicRetailServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
